# WeatherTrack local configuration
# Copy this file to config.toml and fill in your values:
#   cp config.toml.example config.toml
#
# config.toml is gitignored — your credentials stay local.

[wifi]
ssid = "YOUR_WIFI_SSID"
password = "YOUR_WIFI_PASSWORD"

[location]
# By default the weather follows where the device is: its location is looked up from the network
# (IP geolocation) on every boot. The place below is only the fallback when that lookup fails.
latitude = 46.77
longitude = 23.60
name = "Cluj-Napoca"
# Set to true to always use the place above and skip the lookup.
fixed = false
