# ── Rust / Cargo ──────────────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk
Cargo.lock
!Cargo.lock

# Keep workspace lockfile, ignore per-crate lockfiles
!/Cargo.lock
crates/*/Cargo.lock

# ── ESP-IDF / Embedded ───────────────────────────────────────
**/.embuild/
**/build/
**/sdkconfig
**/sdkconfig.old
**/sdkconfig.defaults
*.bin
*.elf
*.map

# ── Editors & IDEs ───────────────────────────────────────────────────
/.vscode/
/.idea/
*.iml
.zed/settings.json
*.swp
*.swo
*~
\#*\#
.#*

# ── OS files ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Build output ─────────────────────────────────────────────────────
/dist/
*.log
*.out

# ── Secrets (never commit credentials) ───────────────────────────────
.env
.env.*
secrets.*
config.toml

# Local-only: flash dumps of the original board firmware, code index
backups/
.codegraph/
