import { Theme } from "theme.slint";

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
}

// Small upper-case caption (readable: 12 px).
export component Caption inherits Text {
    color: Theme.muted;
    font-family: Theme.font;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

// A progress bar.
export component Meter inherits Rectangle {
    in property <float> fraction: 0;
    in property <color> fill: Theme.accent;
    height: 8px;
    border-radius: 4px;
    background: Theme.track;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * Math.min(1, Math.max(0, root.fraction));
        height: parent.height;
        border-radius: 4px;
        background: root.fill;
    }
}

// One big number with a unit and a line of text: the building block of the detail pages.
export component BigStat inherits Card {
    in property <string> title;
    in property <string> value;
    in property <string> unit;
    in property <string> sub;
    in property <color> value-color: Theme.text;
    in property <float> fraction: -1;
    in property <color> accent: Theme.accent;

    Caption { x: 12px; y: 8px; text: root.title; }
    Text {
        x: 12px;
        y: 16px;
        text: root.value;
        font-family: Theme.font;
        font-size: 52px;
        font-weight: 700;
        color: root.value-color;
    }
    Text {
        x: 12px;
        y: 72px;
        width: parent.width - 24px;
        text: root.unit;
        font-family: Theme.font;
        font-size: 16px;
        color: Theme.muted;
        overflow: elide;
    }
    Text {
        x: 12px;
        y: 92px;
        width: parent.width - 24px;
        text: root.sub;
        font-family: Theme.font;
        font-size: 14px;
        color: Theme.text;
        overflow: elide;
    }
    if root.fraction >= 0: Meter {
        x: 12px;
        y: parent.height - 15px;
        width: parent.width - 24px;
        fraction: root.fraction;
        fill: root.accent;
    }
}
