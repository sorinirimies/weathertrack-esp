import { Theme } from "../theme.slint";
import { AlertData } from "../types.slint";
import { Card } from "../components/card.slint";

export component AlertsPage inherits Rectangle {
    in property <[AlertData]> alerts;

    pure function sev-color(level: int) -> color {
        return level >= 3 ? #ef4444 : level == 2 ? #fb923c : #facc15;
    }

    if alerts.length == 0: Card {
        x: 20px;
        y: 8px;
        width: 984px;
        height: 436px;
        Text {
            y: parent.height / 2 - 60px;
            width: parent.width;
            horizontal-alignment: center;
            text: "✓";
            color: Theme.good;
            font-family: Theme.font;
            font-size: 84px;
            font-weight: 700;
        }
        Text {
            y: parent.height / 2 + 40px;
            width: parent.width;
            horizontal-alignment: center;
            text: "No active weather alerts";
            color: Theme.text;
            font-family: Theme.font;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            y: parent.height / 2 + 84px;
            width: parent.width;
            horizontal-alignment: center;
            text: "Conditions are normal for your area.";
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 18px;
        }
    }

    for a[i] in alerts: Card {
        visible: i < 3;
        x: 20px;
        y: 8px + i * 148px;
        width: 984px;
        height: 136px;

        Rectangle {
            x: 0px; y: 0px; width: 10px; height: parent.height;
            background: root.sev-color(a.level);
        }
        Text {
            x: 32px; y: 16px;
            text: a.event;
            color: Theme.text; font-family: Theme.font; font-size: 26px; font-weight: 700;
        }
        Rectangle {
            x: parent.width - 24px - self.width; y: 18px;
            width: 110px; height: 30px; border-radius: 15px;
            background: root.sev-color(a.level).with-alpha(0.25);
            Text { text: a.severity; color: root.sev-color(a.level); font-family: Theme.font; font-size: 15px; font-weight: 700; }
        }
        Text {
            x: 32px; y: 56px; width: parent.width - 64px; height: 50px;
            text: a.description;
            wrap: word-wrap;
            overflow: elide;
            color: Theme.muted; font-family: Theme.font; font-size: 17px;
        }
        Text {
            x: 32px; y: 108px;
            text: a.period;
            color: Theme.faint; font-family: Theme.font; font-size: 14px;
        }
    }
}
