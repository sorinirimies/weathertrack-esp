import { Theme } from "../theme.slint";
import { PlaceData } from "../types.slint";
import { Card, Caption } from "../components/card.slint";

// Content area: 1024 x 464. The place in use and how to change it from a phone or computer.
export component PlacePage inherits Rectangle {
    in property <PlaceData> place;

    Card {
        x: 20px;
        y: 8px;
        width: 984px;
        height: 436px;

        Caption { x: 28px; y: 20px; text: "YOUR PLACE"; }
        Text {
            x: 28px;
            y: 44px;
            width: parent.width - 56px;
            text: place.name;
            font-family: Theme.font;
            font-size: 64px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            x: 28px;
            y: 128px;
            text: place.coordinates + "  ·  " + place.source;
            font-family: Theme.font;
            font-size: 22px;
            color: Theme.muted;
        }
        Rectangle { x: 28px; y: 180px; width: parent.width - 56px; height: 1px; background: Theme.card-border; }
        Text {
            x: 28px;
            y: 200px;
            text: "Change it from a phone or computer on the same WiFi network:";
            font-family: Theme.font;
            font-size: 22px;
            color: Theme.text;
        }
        Text {
            x: 28px;
            y: 238px;
            width: parent.width - 56px;
            text: place.url == "" ? "waiting for WiFi..." : place.url;
            font-family: Theme.font;
            font-size: 48px;
            font-weight: 700;
            color: place.url == "" ? Theme.faint : Theme.accent;
            overflow: elide;
        }
        Text {
            x: 28px;
            y: 322px;
            width: parent.width - 56px;
            text: "1. Open the address in a browser.\n2. Type a city, tap Search, then tap the right result.\n3. \"Use my network location\" goes back to automatic.";
            font-family: Theme.font;
            font-size: 20px;
            color: Theme.muted;
        }
    }
}
