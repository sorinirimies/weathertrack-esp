import { Theme } from "../theme.slint";
import { CurrentData } from "../types.slint";
import { Card, Caption } from "../components/card.slint";

component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text;
    Text {
        x: 0px;
        y: 0px;
        text: root.label;
        color: Theme.muted;
        font-family: Theme.font;
        font-size: 15px;
    }
    Text {
        x: 0px;
        y: 20px;
        text: root.value;
        color: root.value-color;
        font-family: Theme.font;
        font-size: 22px;
        font-weight: 700;
    }
}

export component DetailsPage inherits Rectangle {
    in property <CurrentData> cur;
    in property <image> arc;   // rasterized sun path (200x100)

    property <length> cw: 318px;
    property <length> ch: 211px;

    // ── Sun ──────────────────────────────────────────────────────
    Card {
        x: 20px;
        y: 8px;
        width: root.cw;
        height: root.ch;
        Caption { x: 20px; y: 14px; text: "SUN"; }

        Image {
            x: (parent.width - 200px) / 2;
            y: 52px;
            width: 200px;
            height: 100px;
            source: root.arc;
        }
        Rectangle {
            property <float> p: Math.min(1, Math.max(0, root.cur.sun-progress));
            property <length> cx: (parent.width - 200px) / 2 + 100px;
            property <length> cy: 152px;
            x: cx - 100px * Math.cos(p * 180deg) - 9px;
            y: cy - 100px * Math.sin(p * 180deg) - 9px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: Theme.warm;
            visible: root.cur.is-day;
        }
        Rectangle {
            x: 20px; y: 152px; width: parent.width - 40px; height: 1px; background: #243556;
        }
        Text {
            x: 20px; y: 160px;
            text: "↑ " + root.cur.sunrise;
            color: Theme.text; font-family: Theme.font; font-size: 20px; font-weight: 700;
        }
        Text {
            x: parent.width - 20px - self.width; y: 160px;
            text: "↓ " + root.cur.sunset;
            color: Theme.text; font-family: Theme.font; font-size: 20px; font-weight: 700;
        }
        Text {
            y: 108px; width: parent.width;
            horizontal-alignment: center;
            text: root.cur.daylight;
            color: Theme.muted; font-family: Theme.font; font-size: 16px;
        }
    }

    // ── Wind compass ─────────────────────────────────────────────
    Card {
        x: 352px;
        y: 8px;
        width: root.cw;
        height: root.ch;
        Caption { x: 20px; y: 14px; text: "WIND"; }

        Rectangle {
            property <length> r: 62px;
            x: parent.width - 20px - 2 * r - 14px;
            y: 54px;
            width: 2 * r + 14px;
            height: 2 * r + 14px;
            Rectangle {
                x: 7px; y: 7px; width: 2 * r; height: 2 * r;
                border-radius: r;
                border-width: 3px;
                border-color: #3b4f7d;
            }
            Text { x: 0; y: 0; width: parent.width; text: "N"; horizontal-alignment: center; color: Theme.muted; font-family: Theme.font; font-size: 13px; font-weight: 700; }
            Rectangle {
                x: parent.width / 2 + (r - 4px) * Math.sin(root.cur.wind-deg * 1deg) - 8px;
                y: parent.height / 2 - (r - 4px) * Math.cos(root.cur.wind-deg * 1deg) - 8px;
                width: 16px; height: 16px; border-radius: 8px;
                background: #a78bfa;
            }
            Text {
                text: root.cur.wind-dir;
                color: Theme.text; font-family: Theme.font; font-size: 24px; font-weight: 700;
            }
        }
        Text {
            x: 20px; y: 56px;
            text: root.cur.wind-speed;
            color: Theme.text; font-family: Theme.font; font-size: 46px; font-weight: 700;
        }
        Text {
            x: 20px; y: 108px;
            text: "km/h";
            color: Theme.muted; font-family: Theme.font; font-size: 18px;
        }
        Stat { x: 20px; y: 142px; width: 120px; height: 50px; label: "Gusts"; value: root.cur.gusts + " km/h"; }
    }

    // ── Humidity ─────────────────────────────────────────────────
    Card {
        x: 684px;
        y: 8px;
        width: root.cw;
        height: root.ch;
        Caption { x: 20px; y: 14px; text: "HUMIDITY"; }
        Text {
            x: 20px; y: 40px;
            text: Math.round(root.cur.humidity) + "%";
            color: Theme.text; font-family: Theme.font; font-size: 56px; font-weight: 700;
        }
        Rectangle {
            x: 20px; y: 118px; width: parent.width - 40px; height: 14px; border-radius: 7px; background: #0d1730;
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * Math.min(1, root.cur.humidity / 100);
                height: parent.height; border-radius: 7px;
                background: @linear-gradient(90deg, #38bdf8, #6366f1);
            }
        }
        Text {
            x: 20px; y: 148px; width: parent.width - 40px;
            text: root.cur.humidity < 30 ? "Dry air" : root.cur.humidity < 60 ? "Comfortable" : root.cur.humidity < 80 ? "Humid" : "Very humid";
            color: Theme.muted; font-family: Theme.font; font-size: 18px;
        }
        Text {
            x: 20px; y: 174px; width: parent.width - 40px;
            text: "Cloud cover " + Math.round(root.cur.cloud) + "%";
            color: Theme.faint; font-family: Theme.font; font-size: 15px;
        }
    }

    // ── UV ───────────────────────────────────────────────────────
    Card {
        x: 20px;
        y: 233px;
        width: root.cw;
        height: root.ch;
        Caption { x: 20px; y: 14px; text: "UV INDEX"; }
        Text {
            x: 20px; y: 40px;
            text: Math.round(root.cur.uv);
            color: Theme.uv-color(root.cur.uv); font-family: Theme.font; font-size: 56px; font-weight: 700;
        }
        Text {
            x: 110px; y: 70px;
            text: root.cur.uv-label;
            color: Theme.text; font-family: Theme.font; font-size: 22px; font-weight: 700;
        }
        Rectangle {
            x: 20px; y: 128px; width: parent.width - 40px; height: 12px; border-radius: 6px;
            background: @linear-gradient(90deg, #4ade80 0%, #facc15 35%, #fb923c 60%, #ef4444 80%, #a855f7 100%);
            Rectangle {
                x: parent.width * Math.min(1, root.cur.uv / 11) - 7px;
                y: -4px; width: 14px; height: 20px; border-radius: 7px;
                background: Theme.text;
                border-width: 2px; border-color: #0a1327;
            }
        }
        Text {
            x: 20px; y: 156px; width: parent.width - 40px;
            text: root.cur.uv < 3 ? "No protection needed" : root.cur.uv < 6 ? "Sunscreen advised" : root.cur.uv < 8 ? "Seek shade at midday" : "Avoid the sun";
            color: Theme.muted; font-family: Theme.font; font-size: 17px;
        }
    }

    // ── Pressure ─────────────────────────────────────────────────
    Card {
        x: 352px;
        y: 233px;
        width: root.cw;
        height: root.ch;
        Caption { x: 20px; y: 14px; text: "PRESSURE"; }
        Text {
            x: 20px; y: 40px;
            text: root.cur.pressure;
            color: Theme.text; font-family: Theme.font; font-size: 56px; font-weight: 700;
        }
        Text {
            x: 20px; y: 104px;
            text: "hPa  ·  " + root.cur.pressure-label;
            color: Theme.muted; font-family: Theme.font; font-size: 18px;
        }
        Rectangle {
            property <float> v: root.cur.pressure.to-float();
            x: 20px; y: 150px; width: parent.width - 40px; height: 12px; border-radius: 6px;
            background: @linear-gradient(90deg, #f472b6, #a78bfa, #38bdf8);
            Rectangle {
                x: parent.width * Math.min(1, Math.max(0, (parent.v - 970) / 70)) - 7px;
                y: -4px; width: 14px; height: 20px; border-radius: 7px;
                background: Theme.text;
                border-width: 2px; border-color: #0a1327;
            }
        }
        Text { x: 20px; y: 172px; text: "970"; color: Theme.faint; font-family: Theme.font; font-size: 14px; }
        Text { x: parent.width - 20px - self.width; y: 172px; text: "1040"; color: Theme.faint; font-family: Theme.font; font-size: 14px; }
    }

    // ── Precipitation ────────────────────────────────────────────
    Card {
        x: 684px;
        y: 233px;
        width: root.cw;
        height: root.ch;
        Caption { x: 20px; y: 14px; text: "PRECIPITATION"; }
        Text {
            x: 20px; y: 40px;
            text: root.cur.precip;
            color: Theme.text; font-family: Theme.font; font-size: 56px; font-weight: 700;
        }
        Text {
            x: 20px + 128px; y: 78px;
            text: "mm now";
            color: Theme.muted; font-family: Theme.font; font-size: 18px;
        }
        Stat { x: 20px; y: 126px; width: 120px; height: 50px; label: "Rain"; value: root.cur.rain + " mm"; value-color: #38bdf8; }
        Stat { x: 160px; y: 126px; width: 120px; height: 50px; label: "Snow"; value: root.cur.snow + " cm"; value-color: #e0f2fe; }
        Text {
            x: 20px; y: 178px; width: parent.width - 40px;
            text: "Visibility " + root.cur.visibility + " km";
            color: Theme.faint; font-family: Theme.font; font-size: 15px;
        }
    }
}
