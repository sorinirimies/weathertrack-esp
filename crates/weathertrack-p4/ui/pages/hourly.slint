import { Theme } from "../theme.slint";
import { HourData } from "../types.slint";
import { Card, Caption } from "../components/card.slint";

// Chart geometry — must match CHART_W / CHART_H in src/bridge.rs.
export component HourlyPage inherits Rectangle {
    in property <[HourData]> hours;
    in property <image> chart;          // rasterized temperature curve (880x190)
    in property <float> t-min;
    in property <float> t-max;

    property <length> chart-w: 880px;
    property <length> chart-h: 190px;

    Card {
        x: 20px;
        y: 8px;
        width: 984px;
        height: 436px;

        Caption {
            x: 24px;
            y: 14px;
            text: "TEMPERATURE · NEXT 24 HOURS";
        }
        Text {
            x: parent.width - 24px - self.width;
            y: 12px;
            text: "min " + Math.round(root.t-min) + "°   max " + Math.round(root.t-max) + "°";
            color: Theme.muted;
            font-family: Theme.font;
            font-size: 16px;
        }

        // Plot area
        Rectangle {
            x: 52px;
            y: 62px;
            width: root.chart-w;
            height: root.chart-h + 20px;

            // horizontal grid
            for i in 4: Rectangle {
                y: 10px + i * (root.chart-h / 3);
                height: 1px;
                width: parent.width;
                background: #243556;
            }

            Image {
                x: 0px;
                y: 10px;
                width: root.chart-w;
                height: root.chart-h;
                source: root.chart;
            }

            for h[i] in root.hours: Rectangle {
                visible: Math.mod(i, 3) == 0;
                x: h.x - 5px;
                y: 10px + h.y - 5px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Theme.text;
                border-width: 2px;
                border-color: Theme.temp-color(h.temp-val);

                Text {
                    x: -20px + 5px;
                    y: -32px;
                    width: 40px;
                    text: h.temp + "°";
                    horizontal-alignment: center;
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: 17px;
                    font-weight: 700;
                }
            }
        }

        // Rain probability bars
        Caption {
            x: 24px;
            y: 292px;
            text: "RAIN CHANCE";
        }
        Rectangle {
            x: 52px;
            y: 316px;
            width: root.chart-w;
            height: 36px;

            for h[i] in root.hours: Rectangle {
                x: h.x - 8px;
                width: 16px;
                y: parent.height - self.height;
                height: Math.max(3px, parent.height * h.rain-pct / 100);
                border-radius: 3px;
                background: h.rain-pct >= 50 ? #38bdf8 : #2a5f86;
            }
        }

        // Time + icon labels
        for h[i] in root.hours: Rectangle {
            visible: Math.mod(i, 3) == 0;
            x: 52px + h.x - 35px;
            y: 358px;
            width: 70px;
            height: 72px;
            Text {
                y: 0px;
                width: parent.width;
                text: h.time;
                horizontal-alignment: center;
                color: Theme.muted;
                font-family: Theme.font;
                font-size: 15px;
            }
            Text {
                y: 18px;
                width: parent.width;
                text: h.icon;
                horizontal-alignment: center;
                font-family: Theme.icon-font;
                font-size: 32px;
                color: Theme.warm;
            }
            Text {
                y: 58px;
                width: parent.width;
                text: h.rain-pct + "%";
                horizontal-alignment: center;
                color: #38bdf8;
                font-family: Theme.font;
                font-size: 13px;
            }
        }
    }
}
