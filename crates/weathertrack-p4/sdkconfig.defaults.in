# ESP32-P4 (Waveshare ESP32-P4-WIFI6-Touch-LCD-7B) — mirrors Waveshare's examples.
CONFIG_IDF_TARGET="esp32p4"
# This board has silicon rev v1.3 (< v3.00); its factory bootloader is built
# for v0.1..v1.99, so build for the "less than v3" ROM, not REV_MIN_300.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="@PARTITIONS@"
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# PSRAM (32 MB, holds the 1024x600 RGB565 frame buffer)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Runtime
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# Networking / TLS
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
