import { Theme } from "theme.slint";

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
}

// Small upper-case caption.
export component Caption inherits Text {
    color: Theme.muted;
    font-family: Theme.font;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

// A thin progress bar.
export component Meter inherits Rectangle {
    in property <float> fraction: 0;
    in property <color> fill: Theme.accent;
    height: 5px;
    border-radius: 2.5px;
    background: Theme.track;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * Math.min(1, Math.max(0, root.fraction));
        height: parent.height;
        border-radius: 2.5px;
        background: root.fill;
    }
}
