// Forecast day row — compact display for the forecast list.

import { HorizontalBox } from "std-widgets.slint";
import { ForecastDay } from "../types.slint";

export component ForecastRow inherits Rectangle {
    in property <ForecastDay> day;
    height: 20px;
    background: transparent;

    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        Text {
            text: day.date;
            color: #aaaaaa;
            font-size: 12px;
            width: 48px;
            vertical-alignment: center;
        }

        Text {
            text: day.condition-icon;
            font-size: 14px;
            width: 20px;
            vertical-alignment: center;
        }

        Text {
            text: day.condition;
            color: #ffcc00;
            font-size: 12px;
            width: 90px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: day.temp-max + "°";
            color: #ff6644;
            font-size: 12px;
            font-weight: 600;
            width: 40px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            text: day.temp-min + "°";
            color: #4488ff;
            font-size: 12px;
            width: 40px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
