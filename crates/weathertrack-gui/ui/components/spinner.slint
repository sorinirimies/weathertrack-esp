// Loading spinner component — animated dot on a ring.

export component LoadingSpinner inherits Rectangle {
    in property <float> progress: 0;
    in property <string> status: "Loading...";

    background: #000000;

    Rectangle {
        x: (parent.width - 48px) / 2;
        y: 30px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        border-width: 3px;
        border-color: #1a1a2e;

        Rectangle {
            x: 21px + 18px * cos(progress * 360deg);
            y: 21px + 18px * sin(progress * 360deg);
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: #00d4ff;
        }
    }

    Text {
        y: 95px;
        width: 100%;
        text: status;
        color: #ffcc00;
        font-size: 14px;
        horizontal-alignment: center;
    }

    Text {
        x: 100px;
        y: 30px;
    }
}
