import { Theme } from "../theme.slint";
import { DayData } from "../types.slint";
import { Card } from "../card.slint";

// Content area: 320 x 134 — five days of 26 px: weekday, icon, low / high, rain chance.
export component WeekPage inherits Rectangle {
    in property <[DayData]> days;
    in property <float> week-min;
    in property <float> week-max;

    Card {
        x: 6px;
        y: 2px;
        width: 308px;
        height: 132px;

        for d[i] in root.days: Rectangle {
            visible: i < 5;
            x: 0px;
            y: 3px + i * 25.5px;
            width: parent.width;
            height: 25px;

            Text {
                x: 12px;
                width: 76px;
                height: parent.height;
                vertical-alignment: center;
                text: i == 0 ? "Today" : d.weekday;
                font-family: Theme.font;
                font-size: 17px;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                x: 92px;
                width: 30px;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: center;
                text: d.icon;
                font-family: Theme.icon-font;
                font-size: 22px;
                color: Theme.warm;
            }
            Text {
                x: 132px;
                width: 100px;
                height: parent.height;
                vertical-alignment: center;
                text: d.low + "° / " + d.high + "°";
                font-family: Theme.font;
                font-size: 18px;
                font-weight: 700;
                color: Theme.temp-color(d.high-val);
            }
            Text {
                x: 240px;
                width: 56px;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: right;
                text: d.rain-pct + "%";
                font-family: Theme.font;
                font-size: 16px;
                color: d.rain-pct >= 50 ? Theme.rain : Theme.faint;
            }
        }
    }
}
