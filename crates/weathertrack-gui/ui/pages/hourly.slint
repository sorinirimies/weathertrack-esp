import { Theme } from "../theme.slint";
import { HourData } from "../types.slint";
import { Card, Caption } from "../card.slint";

// Content area: 320 x 134. Chart geometry must match src/bridge_config.rs (260 x 56).
// Three labels (every 8 hours) so the numbers can be big.
export component HourlyPage inherits Rectangle {
    in property <[HourData]> hours;
    in property <image> chart;
    in property <float> t-min;
    in property <float> t-max;

    Card {
        x: 6px;
        y: 2px;
        width: 308px;
        height: 132px;

        Caption { x: 14px; y: 6px; text: "NEXT 24 HOURS"; }
        Text {
            x: parent.width - 14px - self.width;
            y: 4px;
            text: Math.round(root.t-min) + "° to " + Math.round(root.t-max) + "°";
            font-family: Theme.font;
            font-size: 15px;
            font-weight: 700;
            color: Theme.text;
        }

        Image {
            x: 24px;
            y: 26px;
            width: 260px;
            height: 56px;
            source: root.chart;
        }

        for h[i] in root.hours: Rectangle {
            visible: Math.mod(i, 8) == 0;
            x: 24px + h.x - 4px;
            y: 26px + h.y - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.text;
            border-width: 2px;
            border-color: Theme.temp-color(h.temp-val);
        }

        for h[i] in root.hours: Rectangle {
            visible: Math.mod(i, 8) == 0;
            x: Math.max(2px, Math.min(24px + h.x - 30px, parent.width - 62px));
            y: 86px;
            width: 60px;
            height: 44px;
            Text {
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                text: h.time;
                font-family: Theme.font;
                font-size: 13px;
                color: Theme.muted;
            }
            Text {
                y: 14px;
                width: parent.width;
                horizontal-alignment: center;
                text: h.temp + "°";
                font-family: Theme.font;
                font-size: 24px;
                font-weight: 700;
                color: Theme.temp-color(h.temp-val);
            }
        }
    }
}
