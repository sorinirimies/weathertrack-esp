import { Theme } from "../theme.slint";
import { CurrentData } from "../types.slint";
import { Card, Caption } from "../card.slint";

// Content area: 320 x 134. One big picture: icon, temperature, condition.
export component NowPage inherits Rectangle {
    in property <CurrentData> cur;

    Card {
        x: 6px;
        y: 2px;
        width: 308px;
        height: 132px;

        Text {
            x: 12px;
            y: 12px;
            text: cur.icon;
            font-family: Theme.icon-font;
            font-size: 56px;
            color: Theme.warm;
        }
        Text {
            x: 84px;
            y: -6px;
            text: cur.temperature + "°";
            font-family: Theme.font;
            font-size: 84px;
            font-weight: 700;
            color: Theme.temp-color(cur.temp-val);
        }
        // feels like / high / low on the right
        Caption { x: 232px; y: 10px; text: "FEELS"; }
        Text {
            x: 232px;
            y: 24px;
            text: cur.feels-like + "°";
            font-family: Theme.font;
            font-size: 22px;
            font-weight: 700;
            color: Theme.text;
        }
        Caption { x: 232px; y: 56px; text: "HIGH / LOW"; }
        Text {
            x: 232px;
            y: 70px;
            text: cur.high + "° / " + cur.low + "°";
            font-family: Theme.font;
            font-size: 18px;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            x: 12px;
            y: 80px;
            width: parent.width - 24px;
            text: cur.condition;
            font-family: Theme.font;
            font-size: 24px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            x: 12px;
            y: 112px;
            width: parent.width - 24px;
            text: "Wind " + cur.wind-speed + " km/h " + cur.wind-dir;
            font-family: Theme.font;
            font-size: 13px;
            color: Theme.muted;
            overflow: elide;
        }
    }
}
