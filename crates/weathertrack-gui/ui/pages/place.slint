import { Theme } from "../theme.slint";
import { PlaceData } from "../types.slint";
import { Card, Caption } from "../card.slint";

// Content area: 320 x 134. The place in use and how to change it from a phone.
export component PlacePage inherits Rectangle {
    in property <PlaceData> place;

    Card {
        x: 6px;
        y: 2px;
        width: 308px;
        height: 132px;

        Caption { x: 12px; y: 8px; text: "YOUR PLACE"; }
        Text {
            x: 12px;
            y: 22px;
            width: parent.width - 24px;
            text: place.name;
            font-family: Theme.font;
            font-size: 26px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            x: 12px;
            y: 54px;
            width: parent.width - 24px;
            text: place.coordinates + " · " + place.source;
            font-family: Theme.font;
            font-size: 12px;
            color: Theme.muted;
            overflow: elide;
        }
        Rectangle { x: 12px; y: 76px; width: parent.width - 24px; height: 1px; background: Theme.card-border; }
        Text {
            x: 12px;
            y: 84px;
            text: "Change it from a phone:";
            font-family: Theme.font;
            font-size: 14px;
            color: Theme.muted;
        }
        Text {
            x: 12px;
            y: 102px;
            width: parent.width - 24px;
            text: place.url == "" ? "waiting for WiFi..." : place.url;
            font-family: Theme.font;
            font-size: 20px;
            font-weight: 700;
            color: place.url == "" ? Theme.faint : Theme.accent;
            overflow: elide;
        }
    }
}
