// Page 0: Current weather hero — big temperature, icon, condition.

import { HorizontalBox } from "std-widgets.slint";
import { WeatherData } from "../types.slint";

export component CurrentHeroPage inherits Rectangle {
    in property <WeatherData> weather;

    background: #000000;

    Text {
        x: 0px;
        y: 10px;
        width: 100%;
        text: weather.location;
        color: #00d4ff;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    Text {
        x: 0px;
        y: 40px;
        width: 100%;
        text: weather.temperature + "°C";
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    HorizontalBox {
        y: 85px;
        x: 0px;
        width: 100%;
        height: 30px;
        alignment: center;
        spacing: 8px;
        Text {
            text: weather.condition-icon;
            font-size: 22px;
            color: #ffcc00;
            vertical-alignment: center;
        }

        Text {
            text: weather.condition;
            font-size: 20px;
            color: #ffcc00;
            vertical-alignment: center;
        }
    }

    Text {
        x: 0px;
        y: 125px;
        width: 100%;
        text: "Feels like " + weather.feels-like + "°C";
        color: #666666;
        font-size: 12px;
        horizontal-alignment: center;
    }
}
