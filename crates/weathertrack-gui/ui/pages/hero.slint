// Page 0: Current weather.

import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { WeatherData } from "../types.slint";

export component CurrentPage inherits Rectangle {
    in property <WeatherData> weather;
    background: #000000;

    VerticalBox {
        alignment: space-around;
        padding: 4px;

        // Row 1: Location
        Text {
            width: 100%;
            text: weather.location;
            color: #00d4ff;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        // Row 2: Temperature + weather icon + condition
        HorizontalBox {
            alignment: center;
            spacing: 10px;

            Text {
                text: weather.temperature + "°";
                color: #ffffff;
                font-size: 36px;
                font-weight: 700;
                vertical-alignment: center;
            }

            // Weather icon from Weather Icons font
            Text {
                text: weather.condition-icon;
                font-family: "Weather Icons";
                font-size: 28px;
                color: #ffcc00;
                vertical-alignment: center;
            }

            Text {
                text: weather.condition;
                color: #ffcc00;
                font-size: 16px;
                vertical-alignment: center;
            }
        }

        // Row 3: Key details
        HorizontalBox {
            alignment: center;
            spacing: 20px;
            Text {
                text: "Feel " + weather.feels-like + "°";
                color: #ff6644;
                font-size: 16px;
                vertical-alignment: center;
            }

            Text {
                text: weather.humidity + "%";
                color: #00d4ff;
                font-size: 16px;
                vertical-alignment: center;
            }

            Text {
                text: weather.wind-speed;
                color: #00ff88;
                font-size: 16px;
                vertical-alignment: center;
            }
        }
    }
}
