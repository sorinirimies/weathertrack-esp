// Page 0: Current weather — location, temperature, condition, details.

import { HorizontalBox } from "std-widgets.slint";
import { WeatherData } from "../types.slint";

export component CurrentPage inherits Rectangle {
    in property <WeatherData> weather;

    background: #000000;

    // Location
    Text {
        x: 0px;
        y: 6px;
        width: 100%;
        text: weather.location;
        color: #00d4ff;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    // Big temperature
    Text {
        x: 0px;
        y: 28px;
        width: 100%;
        text: weather.temperature + "°C";
        color: #ffffff;
        font-size: 32px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    // Condition icon + label
    HorizontalBox {
        y: 72px;
        x: 0px;
        width: 100%;
        height: 24px;
        alignment: center;
        spacing: 6px;
        Text {
            text: weather.condition-icon;
            font-size: 18px;
            color: #ffcc00;
            vertical-alignment: center;
        }

        Text {
            text: weather.condition;
            font-size: 16px;
            color: #ffcc00;
            vertical-alignment: center;
        }
    }

    // Details row: feels-like | humidity | wind
    HorizontalBox {
        y: 104px;
        x: 10px;
        width: 300px;
        height: 20px;
        alignment: space-between;
        Text {
            text: "Feel " + weather.feels-like + "°";
            color: #ff6644;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: "Hum " + weather.humidity + "%";
            color: #00d4ff;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: "W " + weather.wind-speed;
            color: #00ff88;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    // Details row 2: pressure | cloud
    HorizontalBox {
        y: 128px;
        x: 10px;
        width: 300px;
        height: 20px;
        alignment: space-between;
        Text {
            text: weather.pressure + " hPa";
            color: #aaaaaa;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: "Cloud " + weather.cloud-cover + "%";
            color: #666666;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: "";
        }
    }
}
