import { Theme } from "../theme.slint";
import { AlertData } from "../types.slint";
import { Card } from "../card.slint";

// Content area: 320 x 134. The most severe alert, big; the rest are counted.
export component AlertsPage inherits Rectangle {
    in property <[AlertData]> alerts;

    pure function sev-color(level: int) -> color {
        return level >= 3 ? #ef4444 : level == 2 ? #fb923c : #facc15;
    }

    if alerts.length == 0: Card {
        x: 6px;
        y: 2px;
        width: 308px;
        height: 132px;
        Text {
            y: 34px;
            width: parent.width;
            horizontal-alignment: center;
            text: "No active alerts";
            font-family: Theme.font;
            font-size: 24px;
            font-weight: 700;
            color: Theme.good;
        }
        Text {
            y: 72px;
            width: parent.width;
            horizontal-alignment: center;
            text: "Conditions are normal.";
            font-family: Theme.font;
            font-size: 15px;
            color: Theme.muted;
        }
    }

    if alerts.length > 0: Card {
        clip: true;
        x: 6px;
        y: 2px;
        width: 308px;
        height: 132px;
        Rectangle { x: 0px; y: 0px; width: 8px; height: parent.height; background: root.sev-color(alerts[0].level); }
        Text {
            x: 20px;
            y: 8px;
            width: 190px;
            text: alerts[0].event;
            font-family: Theme.font;
            font-size: 22px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            x: parent.width - 12px - self.width;
            y: 12px;
            text: alerts[0].severity;
            font-family: Theme.font;
            font-size: 14px;
            font-weight: 700;
            color: root.sev-color(alerts[0].level);
        }
        Text {
            x: 20px;
            y: 42px;
            width: parent.width - 32px;
            height: 56px;
            text: alerts[0].description;
            wrap: word-wrap;
            overflow: elide;
            font-family: Theme.font;
            font-size: 15px;
            color: Theme.muted;
        }
        Text {
            x: 20px;
            y: 104px;
            width: parent.width - 32px;
            text: alerts.length > 1 ? "+" + (alerts.length - 1) + " more · " + alerts[0].period : alerts[0].period;
            font-family: Theme.font;
            font-size: 12px;
            color: Theme.faint;
            overflow: elide;
        }
    }
}
