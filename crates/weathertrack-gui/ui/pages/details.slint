// Page 1: Weather details — humidity, wind, pressure, cloud.

import { HorizontalBox } from "std-widgets.slint";
import { WeatherData } from "../types.slint";

component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: #ffffff;

    x: 20px;
    width: 280px;
    height: 24px;

    HorizontalBox {
        alignment: space-between;
        Text {
            text: label;
            color: #888888;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: value;
            color: value-color;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component DetailsPage inherits Rectangle {
    in property <WeatherData> weather;

    background: #000000;

    Text {
        x: 0px;
        y: 8px;
        width: 100%;
        text: "Details";
        color: #00d4ff;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    DetailRow {
        y: 34px;
        label: "Humidity";
        value: weather.humidity + "%";
        value-color: #00d4ff;
    }

    DetailRow {
        y: 62px;
        label: "Wind";
        value: weather.wind-speed + " km/h";
        value-color: #00ff88;
    }

    DetailRow {
        y: 90px;
        label: "Pressure";
        value: weather.pressure + " hPa";
        value-color: #ffffff;
    }

    DetailRow {
        y: 118px;
        label: "Cloud";
        value: weather.cloud-cover + "%";
        value-color: #aaaaaa;
    }
}
