import { Theme } from "../theme.slint";
import { CurrentData } from "../types.slint";
import { Card, Caption, Meter } from "../card.slint";

component Tile inherits Card {
    in property <string> title;
    in property <string> value;
    in property <string> sub;
    in property <float> fraction: -1;
    in property <color> accent: Theme.accent;
    in property <color> value-color: Theme.text;
    in property <length> value-size: 15px;

    Caption { x: 8px; y: 5px; text: root.title; }
    Text {
        x: 8px;
        y: 17px;
        width: parent.width - 16px;
        text: root.value;
        font-family: Theme.font;
        font-size: root.value-size;
        font-weight: 700;
        color: root.value-color;
        overflow: elide;
    }
    Text {
        x: 8px;
        y: 38px;
        width: parent.width - 16px;
        text: root.sub;
        font-family: Theme.font;
        font-size: 9px;
        color: Theme.muted;
        overflow: elide;
    }
    if root.fraction >= 0: Meter {
        x: 8px;
        y: parent.height - 11px;
        width: parent.width - 16px;
        fraction: root.fraction;
        fill: root.accent;
    }
}

// Content area: 320 x 134 — 3 x 2 tiles of 100 x 64.
export component DetailsPage inherits Rectangle {
    in property <CurrentData> cur;

    Tile { x: 6px;   y: 2px;  width: 100px; height: 64px; title: "SUN"; value-size: 12px; value: cur.sunrise + " - " + cur.sunset; sub: cur.daylight; fraction: cur.sun-progress; accent: Theme.warm; }
    Tile { x: 110px; y: 2px;  width: 100px; height: 64px; title: "WIND";     value: cur.wind-speed + " km/h"; sub: cur.wind-dir + " · gusts " + cur.gusts; }
    Tile { x: 214px; y: 2px;  width: 100px; height: 64px; title: "HUMIDITY"; value: Math.round(cur.humidity) + "%"; sub: "cloud " + Math.round(cur.cloud) + "%"; fraction: cur.humidity / 100; accent: Theme.rain; }
    Tile { x: 6px;   y: 70px; width: 100px; height: 64px; title: "UV INDEX"; value: Math.round(cur.uv) + " " + cur.uv-label; sub: "index 0 - 11+"; fraction: cur.uv / 11; accent: Theme.uv-color(cur.uv); value-color: Theme.uv-color(cur.uv); }
    Tile { x: 110px; y: 70px; width: 100px; height: 64px; title: "PRESSURE"; value: cur.pressure + " hPa"; sub: cur.pressure-label; fraction: (cur.pressure.to-float() - 970) / 70; accent: Theme.muted; }
    Tile { x: 214px; y: 70px; width: 100px; height: 64px; title: "PRECIP";   value: cur.precip + " mm"; sub: "vis " + cur.visibility + " km"; }
}
