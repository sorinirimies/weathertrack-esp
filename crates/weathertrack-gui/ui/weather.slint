// WeatherTrack GUI — main Slint entry point.
// Composes pages and components from sub-modules.

import { WeatherData, ForecastDay, AlertData } from "types.slint";
import { LoadingSpinner } from "components/spinner.slint";
import { CurrentHeroPage } from "pages/hero.slint";
import { DetailsPage } from "pages/details.slint";
import { ForecastPage } from "pages/forecast.slint";

export { WeatherData, ForecastDay, AlertData }

export component WeatherApp inherits Window {
    in property <int> current-page: 0;
    in property <bool> loading: true;
    in property <string> loading-status: "Starting...";
    in property <float> spinner-progress: 0;
    in property <WeatherData> current-weather;
    in property <[ForecastDay]> forecast-days;
    in property <[AlertData]> alerts;
    in property <string> page-info: "1/3";

    width: 320px;
    height: 172px;
    background: #000000;

    if loading: LoadingSpinner {
        width: 100%;
        height: 100%;
        progress: spinner-progress;
        status: loading-status;
    }

    if !loading && current-page == 0: CurrentHeroPage {
        width: 100%;
        height: 100%;
        weather: current-weather;
    }

    if !loading && current-page == 1: DetailsPage {
        width: 100%;
        height: 100%;
        weather: current-weather;
    }

    if !loading && current-page == 2: ForecastPage {
        width: 100%;
        height: 100%;
        days: forecast-days;
    }

    // Page indicator
    if !loading: Rectangle {
        y: parent.height - 16px;
        height: 16px;
        width: 100%;
        Text {
            text: page-info;
            color: #444444;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
