import { VerticalBox, HorizontalBox } from "std-widgets.slint";

// Weather data model
export struct WeatherData {
    location: string,
    temperature: string,
    feels-like: string,
    condition: string,
    condition-icon: string,
    humidity: string,
    pressure: string,
    wind-speed: string,
    wind-gusts: string,
    cloud-cover: string,
    precipitation: string,
    sunrise: string,
    sunset: string,
}

export struct ForecastDay {
    date: string,
    condition-icon: string,
    condition: string,
    temp-max: string,
    temp-min: string,
    rain-pct: string,
    wind: string,
    uv: string,
}

export struct AlertData {
    icon: string,
    event: string,
    description: string,
}

// Animated loading spinner
component LoadingSpinner inherits Rectangle {
    in property <float> progress: 0;
    in property <string> status: "Loading...";

    background: #000000;

    // Spinning arc animation
    Rectangle {
        x: (parent.width - 48px) / 2;
        y: 30px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        border-width: 3px;
        border-color: #1a1a2e;

        // Animated dot
        Rectangle {
            x: 21px + 18px * cos(progress * 360deg);
            y: 21px + 18px * sin(progress * 360deg);
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: #00d4ff;
        }
    }

    Text {
        y: 95px;
        width: 100%;
        text: status;
        color: #ffcc00;
        font-size: 14px;
        horizontal-alignment: center;
    }
}

// Page 0: Current weather hero
component CurrentHeroPage inherits Rectangle {
    in property <WeatherData> weather;

    background: #000000;

    // Location name at top
    Text {
        x: 0px;
        y: 10px;
        width: 100%;
        text: weather.location;
        color: #00d4ff;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    // Big temperature in center
    Text {
        x: 0px;
        y: 40px;
        width: 100%;
        text: weather.temperature + "°C";
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    // Weather icon + condition label
    HorizontalBox {
        y: 85px;
        x: 0px;
        width: 100%;
        height: 30px;
        alignment: center;
        spacing: 8px;

        Text {
            text: weather.condition-icon;
            font-size: 22px;
            color: #ffcc00;
            vertical-alignment: center;
        }
        Text {
            text: weather.condition;
            font-size: 20px;
            color: #ffcc00;
            vertical-alignment: center;
        }
    }

    // Feels like at bottom
    Text {
        x: 0px;
        y: 125px;
        width: 100%;
        text: "Feels like " + weather.feels-like + "°C";
        color: #666666;
        font-size: 12px;
        horizontal-alignment: center;
    }
}

// Page 1: Current details
component DetailsPage inherits Rectangle {
    in property <WeatherData> weather;

    background: #000000;

    // Title
    Text {
        x: 0px;
        y: 8px;
        width: 100%;
        text: "Details";
        color: #00d4ff;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    // Detail rows
    // Row 1: Humidity
    Rectangle {
        x: 20px;
        y: 34px;
        width: 280px;
        height: 24px;

        HorizontalBox {
            alignment: space-between;
            Text {
                text: "Humidity";
                color: #888888;
                font-size: 13px;
                vertical-alignment: center;
            }
            Text {
                text: weather.humidity + "%";
                color: #00d4ff;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    // Row 2: Wind
    Rectangle {
        x: 20px;
        y: 62px;
        width: 280px;
        height: 24px;

        HorizontalBox {
            alignment: space-between;
            Text {
                text: "Wind";
                color: #888888;
                font-size: 13px;
                vertical-alignment: center;
            }
            Text {
                text: weather.wind-speed + " km/h";
                color: #00ff88;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    // Row 3: Pressure
    Rectangle {
        x: 20px;
        y: 90px;
        width: 280px;
        height: 24px;

        HorizontalBox {
            alignment: space-between;
            Text {
                text: "Pressure";
                color: #888888;
                font-size: 13px;
                vertical-alignment: center;
            }
            Text {
                text: weather.pressure + " hPa";
                color: #ffffff;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    // Row 4: Cloud cover
    Rectangle {
        x: 20px;
        y: 118px;
        width: 280px;
        height: 24px;

        HorizontalBox {
            alignment: space-between;
            Text {
                text: "Cloud";
                color: #888888;
                font-size: 13px;
                vertical-alignment: center;
            }
            Text {
                text: weather.cloud-cover + "%";
                color: #aaaaaa;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

// Forecast day row (simplified)
component ForecastRow inherits Rectangle {
    in property <ForecastDay> day;
    height: 20px;
    background: transparent;

    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        Text {
            text: day.date;
            color: #aaaaaa;
            font-size: 12px;
            width: 48px;
            vertical-alignment: center;
        }
        Text {
            text: day.condition-icon;
            font-size: 14px;
            width: 20px;
            vertical-alignment: center;
        }
        Text {
            text: day.condition;
            color: #ffcc00;
            font-size: 12px;
            width: 90px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: day.temp-max + "°";
            color: #ff6644;
            font-size: 12px;
            font-weight: 600;
            width: 40px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            text: day.temp-min + "°";
            color: #4488ff;
            font-size: 12px;
            width: 40px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Page 2: Forecast
component ForecastPage inherits Rectangle {
    in property <[ForecastDay]> days;

    background: #000000;

    // Title
    Text {
        x: 0px;
        y: 6px;
        width: 100%;
        text: "Forecast";
        color: #00d4ff;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    // Forecast rows
    VerticalBox {
        y: 28px;
        x: 0px;
        width: 100%;
        height: 140px;
        spacing: 0px;
        padding: 0px;

        for day in days: ForecastRow { day: day; }
    }
}

// Main app window
export component WeatherApp inherits Window {
    // Properties set from Rust
    in property <int> current-page: 0;
    in property <bool> loading: true;
    in property <string> loading-status: "Starting...";
    in property <float> spinner-progress: 0;
    in property <WeatherData> current-weather;
    in property <[ForecastDay]> forecast-days;
    in property <[AlertData]> alerts;
    in property <string> page-info: "1/3";

    width: 320px;
    height: 172px;
    background: #000000;

    if loading: LoadingSpinner {
        width: 100%;
        height: 100%;
        progress: spinner-progress;
        status: loading-status;
    }

    if !loading && current-page == 0: CurrentHeroPage {
        width: 100%;
        height: 100%;
        weather: current-weather;
    }

    if !loading && current-page == 1: DetailsPage {
        width: 100%;
        height: 100%;
        weather: current-weather;
    }

    if !loading && current-page == 2: ForecastPage {
        width: 100%;
        height: 100%;
        days: forecast-days;
    }

    // Page indicator at bottom
    if !loading: Rectangle {
        y: parent.height - 16px;
        height: 16px;
        width: 100%;
        Text {
            text: page-info;
            color: #444444;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
