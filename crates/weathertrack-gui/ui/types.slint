// Shared data model types for the weather UI.

export struct WeatherData {
    location: string,
    temperature: string,
    feels-like: string,
    condition: string,
    condition-icon: string,
    humidity: string,
    pressure: string,
    wind-speed: string,
    wind-gusts: string,
    cloud-cover: string,
    precipitation: string,
    sunrise: string,
    sunset: string,
}

export struct ForecastDay {
    date: string,
    condition-icon: string,
    condition: string,
    temp-max: string,
    temp-min: string,
    rain-pct: string,
    wind: string,
    uv: string,
}

export struct AlertData {
    icon: string,
    event: string,
    description: string,
}
